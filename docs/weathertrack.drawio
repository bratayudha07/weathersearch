  <diagram id="3tMoBI7EHkgE5NvpPA-j" name="Page-2">
    <mxGraphModel dx="1308" dy="868" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction LR\n\n    class WeatherController {\n        &lt;&lt;FastAPI Router&gt;&gt;\n        +search_weather(city: str) WeatherReport\n    }\n\n    class WeatherService {\n        -api_client: WeatherAPIClient\n        +get_weather_report(city: str) WeatherReport\n    }\n\n    class WeatherAPIClient {\n        -base_url: str\n        -geocoding_url: str\n        -archive_url: str\n        +search_location(city: str) dict\n        +get_current_weather(latitude: float, longitude: float) dict\n        +get_historical_weather(latitude: float, longitude: float, start_date: str, end_date: str) dict\n    }\n\n    class Location {\n        +name: str\n        +country: str\n        +latitude: float\n        +longitude: float\n        +get_info() str\n    }\n\n    class CurrentWeather {\n        +temperature: float\n        +precipitation: float\n        +weather_code: int\n        +condition: str\n        +get_info() str\n    }\n\n    class DailyWeather {\n        +date: str\n        +temp_max: float\n        +temp_min: float\n        +precipitation: float\n        +weather_code: int\n        +condition: str\n        +get_info() str\n    }\n\n    class WeatherReport {\n        +location: Location\n        +current_weather: CurrentWeather\n        +daily_history: list~DailyWeather~\n    }\n\n    WeatherController ..&gt; WeatherService : menggunakan\n    WeatherService ..&gt; WeatherAPIClient : menggunakan\n    WeatherService ..&gt; Location : membuat\n    WeatherService ..&gt; CurrentWeather : membuat\n    WeatherService ..&gt; DailyWeather : membuat\n    WeatherService ..&gt; WeatherReport : menghasilkan\n\n    WeatherReport \&quot;1\&quot; *-- \&quot;1\&quot; Location : memiliki\n    WeatherReport \&quot;1\&quot; *-- \&quot;1\&quot; CurrentWeather : memiliki\n    WeatherReport \&quot;1\&quot; *-- \&quot;7\&quot; DailyWeather : memiliki&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IrI7lJCMtK0Og3C3GmXs-1">
